{
	"FileVersion": 3,
	"EngineAssociation": "5.8",
	"Category": "Samples",
	"Description": "Musubi demo: Epic's Third Person template on a Musubi dedicated server (seamless handover between servers, possession and inventory follow the player)",
	"Modules": [
		{
			"Name": "MusubiThirdPerson",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "MusubiThirdPersonEditor",
			"Type": "Editor",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "Musubi",
			"Enabled": true
		},
		{
			"Name": "EnhancedInput",
			"Enabled": true
		},
		{
			"Name": "ModelingToolsEditorMode",
			"Enabled": true,
			"TargetAllowList": [
				"Editor"
			]
		}
	]
}
